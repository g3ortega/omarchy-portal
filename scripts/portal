#!/bin/bash
# Portal from the terminal.
#
# The panel is the primary interface, but everything it does is available here
# too — which is what makes the plugin developable and scriptable. Uses the
# running shell over IPC when it is up, and falls back to the scripts directly
# when it is not, so this works while hacking on the plugin with the shell down.

set -o pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ID="g3ortega.portal"

have() { command -v "$1" >/dev/null 2>&1; }
SHELL_UP=""
shell_up() {
  [[ -n $SHELL_UP ]] || { have omarchy-shell && [[ $(omarchy-shell shell ping 2>/dev/null) == ok ]]; SHELL_UP=$?; }
  return "$SHELL_UP"
}

# --- data sources: prefer the live plugin, fall back to the scripts -----------
get_ports() {
  # One IPC round-trip: capture the live plugin's answer, fall back to running
  # the same scan + Detect.js pipeline the shell uses (via the shared loader).
  local out
  if shell_up && out=$(omarchy-shell "$PLUGIN_ID" ports 2>/dev/null) && [[ -n $out ]]; then
    printf '%s' "$out"
  else
    have node || { echo "portal: the shell is down and node is not installed" >&2; return 1; }
    node "$HERE/lib/qmljs.mjs" decorate "$HERE/scan-ports.sh"
  fi
}

get_tunnels() {
  local out status_rc
  if shell_up && out=$(omarchy-shell "$PLUGIN_ID" tunnels 2>/dev/null) && [[ -n $out ]]; then
    jq -e 'if type == "object" then [.[]] elif type == "array" then . else error("not a tunnel collection") end' <<<"$out" \
      || { echo "portal: the shell returned invalid tunnel status" >&2; return 1; }
  else
    out=$("$HERE/tunnels.sh" status); status_rc=$?
    if (( status_rc != 0 )) || ! jq -e '.ok == true and (.tunnels | type == "array")' <<<"$out" >/dev/null 2>&1; then
      echo "portal: $(jq -r '.error // "could not read tunnel status"' <<<"$out" 2>/dev/null)" >&2
      return 1
    fi
    jq -c '.tunnels' <<<"$out"
  fi
}

# Detect.js emits an icon NAME; lib/Icons.js maps it to a codepoint. Resolve
# through the shared loader so the terminal and the panel show the same glyph.
icon_map() {
  have node || { echo '{}'; return; }
  node "$HERE/lib/qmljs.mjs" icons 2>/dev/null || echo '{}'
}

cmd_list() {
  local show_all=0
  [[ ${1:-} == --all ]] && show_all=1
  local ports tunnels icons
  ports=$(get_ports) || { echo "portal: could not read ports" >&2; exit 1; }
  tunnels=$(get_tunnels) || exit 1
  icons=$(icon_map)

  jq -r --argjson tunnels "$tunnels" --argjson all "$show_all" --argjson icons "$icons" '
    map(select($all == 1 or .category != "system"))
    | sort_by(
        (if .category == "dev" then 0 elif .category == "service" then 1 else 2 end),
        .port
      )
    | .[]
    | . as $p
    | ($tunnels | map(select(.port == $p.port)) | first) as $t
    | [
        (.port|tostring),
        ($icons[.icon] // " "),
        .label,
        (if (.name // "") == .label then "" else (.name // "") end),
        .scope,
        (if $t then ($t.url + (if $t.reach == "public" then "  [PUBLIC]" elif $t.reach == "lan" then "  [LAN]" else "  [local]" end))
         else (.url // "") end)
      ] | @tsv
  ' <<<"$ports" | column -t -s$'\t'
}

cmd_providers() {
  local out rc
  out=$("$HERE/tunnels.sh" providers); rc=$?
  if (( rc != 0 )) || ! jq -e '.ok == true and (.providers | type == "array")' <<<"$out" >/dev/null 2>&1; then
    echo "portal: $(jq -r '.error // "could not read provider status"' <<<"$out" 2>/dev/null)" >&2
    return 1
  fi
  jq -r '.providers[] | [.label, .status, .reach, .detail] | @tsv' <<<"$out" | column -t -s$'\t'
}

cmd_expose() {
  local provider="${1:-}" port="${2:-}" out rc
  [[ -n $provider && -n $port ]] || { echo "usage: portal expose <cloudflared|ngrok|portless> <port> [name]" >&2; exit 2; }
  out=$("$HERE/tunnels.sh" start "$provider" "$port" "${3:-}"); rc=$?
  if (( rc != 0 )) || ! jq -e '.ok == true' <<<"$out" >/dev/null 2>&1; then
    echo "error: $(jq -r '.error // "share failed"' <<<"$out" 2>/dev/null)" >&2
    return 1
  fi
  jq -r '.url + (if .reach=="public" then "  [PUBLIC]" else "  [local]" end)' <<<"$out"
}

cmd_stop() {
  local provider="${1:-}" port="${2:-}" out rc
  [[ -n $provider && -n $port ]] || { echo "usage: portal stop <provider> <port>" >&2; exit 2; }
  out=$("$HERE/tunnels.sh" stop "$provider" "$port"); rc=$?
  if (( rc != 0 )) || ! jq -e '.ok == true' <<<"$out" >/dev/null 2>&1; then
    echo "error: $(jq -r '.error // "stop failed"' <<<"$out" 2>/dev/null)" >&2
    return 1
  fi
  printf 'stopped %s on %s\n' "$provider" "$port"
}

cmd_stop_all() {
  local out rc
  out=$("$HERE/tunnels.sh" stop-all); rc=$?
  if (( rc != 0 )) || ! jq -e '.ok == true' <<<"$out" >/dev/null 2>&1; then
    echo "error: $(jq -r '.error // "stop-all failed"' <<<"$out" 2>/dev/null)" >&2
    return 1
  fi
  echo "stopped every share"
}

cmd_setup() {
  local mode=run out rc
  case "${1:-}" in
    --status) mode=status ;;
    "") ;;
    *) echo "usage: portal setup [--status]" >&2; return 2 ;;
  esac
  out=$("$HERE/portless-setup.sh" "$mode"); rc=$?
  if (( rc != 0 )) || ! jq -e '.ok == true' <<<"$out" >/dev/null 2>&1; then
    echo "error: $(jq -r '.error // "setup failed"' <<<"$out" 2>/dev/null)" >&2
    return 1
  fi
  jq '.remaining |= map(gsub("\u001f"; ": "))' <<<"$out"
}

cmd_shared() { get_tunnels | jq -r '.[] | [.provider, (.port|tostring), .reach, .url] | @tsv' | column -t -s$'\t'; }

cmd_doctor() {
  printf 'portal         %s\n' "$(jq -r .version "$HERE/../manifest.json" 2>/dev/null)"
  printf 'plugin dir     %s\n' "$(cd "$HERE/.." && pwd)"
  printf 'shell          %s\n' "$(shell_up && echo running || echo 'not running (offline mode)')"
  printf 'ss             %s\n' "$(have ss && echo ok || echo MISSING)"
  printf 'jq             %s\n' "$(have jq && echo ok || echo MISSING)"
  printf 'python3        %s\n' "$(have python3 && echo ok || echo 'MISSING (helpers need it)')"
  printf 'flock          %s\n' "$(have flock && echo ok || echo 'MISSING (state changes need it)')"
  printf 'sqlite3        %s\n' "$(have sqlite3 && echo ok || echo 'MISSING (history needs it)')"
  printf 'curl           %s\n' "$(have curl && echo ok || echo 'MISSING (probes and tunnels need it)')"
  printf 'node           %s\n' "$(have node && node --version || echo 'MISSING (offline list needs it)')"
  printf 'wl-copy        %s\n' "$(have wl-copy && echo ok || echo 'MISSING (copy button will not work)')"
  printf 'xdg-open       %s\n' "$(have xdg-open && echo ok || echo 'MISSING (open button will not work)')"
  echo
  echo 'providers:'
  cmd_providers | sed 's/^/  /'
  echo
  printf 'manifest       %s\n' "$(omarchy plugin validate "$HERE/.." >/dev/null 2>&1 && echo valid || echo INVALID)"
  printf 'enabled        %s\n' "$(omarchy plugin list --json 2>/dev/null | jq -r --arg id "$PLUGIN_ID" '.[]|select(.id==$id)|.enabled' 2>/dev/null || echo unknown)"
}

case "${1:-list}" in
  list)      shift; cmd_list "$@" ;;
  shared)    cmd_shared ;;
  providers) cmd_providers ;;
  expose)    shift; cmd_expose "$@" ;;
  stop)      shift; cmd_stop "$@" ;;
  stop-all)  cmd_stop_all ;;
  uninstall) shift; "$HERE/uninstall.sh" "$@" ;;
  doctor)    cmd_doctor ;;
  refresh)   omarchy-shell "$PLUGIN_ID" refresh ;;
  setup)     shift; cmd_setup "$@" ;;
  test)      "$HERE/../test/test.sh" ;;
  -h|--help|help)
    cat <<USAGE
 ___         _        _
| _ \___ _ _| |_ __ _| |
|  _/ _ \ '_|  _/ _\` | |
|_| \___/_|  \__\__,_|_|   $(jq -r .version "$HERE/../manifest.json" 2>/dev/null) · listening ports, what is on them, and how to share them

  portal [list] [--all]              list ports (--all includes system ports)
  portal shared                      list active shares
  portal providers                   exposure providers and their readiness
  portal expose <provider> <port> [name]
  portal stop <provider> <port>
  portal stop-all                    stop every share and name
  portal uninstall [--dry]           reverse what Portal put on the machine
  portal refresh                     ask the running shell to rescan
  portal setup [--status]            set up local names, or inspect without changes
  portal doctor                      check the plugin's dependencies
  portal test                        run the unit tests

Providers: cloudflared and ngrok publish to the internet. portless only
creates a local name on this machine; it does not expose anything.
USAGE
    ;;
  *) echo "portal: unknown command '$1' (try --help)" >&2; exit 2 ;;
esac
